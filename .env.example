# Backend
DATABASE_URL=sqlite+aiosqlite:///./waste_management.db
MODEL_SERVICE_URL=http://localhost:8001
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Browser origins allowed to call the API (comma-separated). Add your deployed frontend here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGIN_REGEX=https://.*\.example\.com
SEED_ON_STARTUP=true

# Model service
HF_REPO_ID=W4ashabii/waste_classifier
HF_FILENAME=best.pt
# WEIGHTS_PATH=/path/to/best.pt   # use local weights instead of downloading
# DEVICE=cuda:0                   # default: auto
